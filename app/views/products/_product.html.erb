<div id="<%= dom_id product %>">
  <div>
    <strong>Name:</strong>
    <%= product.name %>
  </div>

  <div>
    <strong>Description:</strong>
    <%= product.description %>
  </div>

  <div>
    <strong>Base price:</strong>
    <%= product.base_price %>
  </div>

  <div>
    <strong>Tax price:</strong>
    <%= product.tax_price %>
  </div>

  <div>
    <strong>Quantity:</strong>
    <%= product.quantity %>
  </div>

</div>
